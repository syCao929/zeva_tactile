# ===========================================================================
# 巨型目录 —— 数据 / 环境 / 产物，合计约 670GB，绝对不入库
# 注意：.gitignore 不支持行尾注释，模式必须独占一行，否则整行会被当成模式
# ===========================================================================

# 权重（约 101GB），可用 tools/fetch-weights.sh 重新获取
/models/

# 训练输出（约 548GB）
/runs/

# Python 环境（conda，约 11GB），按 README_ZEVA_ENV.md §2 重建
/envs/

# HF / pip / torch / uv 缓存（约 13GB）
/cache/

# 转换后的训练数据，可由 tools/convert_xhand_dataset.py 重建
/datasets/

/logs/
/tmp/

# RoboCasa365 仿真器，按官方文档单独获取
/sim/

# ===========================================================================
# 上游仓库的完整副本
# Zeva/ 是 overlay 的原始来源，只读参照；内容已叠加进 cosmos-framework/，
# 需要时可从 github.com/air-embodied-brain/Zeva 重新 clone（省 79MB）
# ===========================================================================
/Zeva/

# ===========================================================================
# tools/ 下的第三方 vendor（约 212MB）
# 你自己的脚本 tools/*.sh、tools/*.py 是要入库的，别整个忽略 tools/
# ===========================================================================

/tools/uv/
/tools/uv-tools/
/tools/bin/

# uv 下载的 CPython
/tools/python/

# megatron / lerobot 源码 checkout
/tools/src/

# ===========================================================================
# 本机私有配置（含机器相关路径，不入库）
# ===========================================================================
env.local.sh
.claude/settings.local.json

# ===========================================================================
# Python
# ===========================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
downloads/
eggs/
.eggs/
wheels/
*.egg-info/
*.egg
MANIFEST
.venv/
venv/
env/
ENV/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyre/
.pytype/
.hypothesis/
.tox/
.nox/
.ipynb_checkpoints/
__pypackages__/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.cover

# ===========================================================================
# 凭据 —— 绝不入库
# ===========================================================================
/credentials/
.env
*.env
.env.*

# ===========================================================================
# 编辑器 / 系统
# ===========================================================================
.DS_Store
*.swp
.idea/
.vscode/
.cursorignore
.cursorindexingignore
*.log

# ===========================================================================
# 权重与媒体大文件
# ===========================================================================
*.pt
*.pth
*.distcp
*.safetensors
*.ckpt
*.bin
*.mp4
